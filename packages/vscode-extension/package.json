{
  "name": "agent-swarm",
  "displayName": "Agent Swarm",
  "description": "Agent Swarm integration for VS Code",
  "version": "0.1.0",
  "publisher": "agent-swarm",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentSwarm.createTask",
        "title": "Create Task"
      },
      {
        "command": "agentSwarm.showTasks",
        "title": "Show Tasks"
      },
      {
        "command": "agentSwarm.showAgents",
        "title": "Show Agents"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "agentSwarmTasks",
          "name": "Agent Swarm Tasks"
        },
        {
          "id": "agentSwarmAgents",
          "name": "Agent Swarm Agents"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentSwarm",
          "title": "Agent Swarm",
          "icon": "$(beaker)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean": "rm -rf out || rmdir /s /q out || true"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}

