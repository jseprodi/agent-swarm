# Agent Swarm API Server Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=3000

# Logging
# Options: debug, info, warn, error
LOG_LEVEL=info

# LLM Provider Configuration
# Options: cursor, openai, anthropic
LLM_PROVIDER=cursor

# LLM Model (provider-specific)
# For OpenAI: gpt-4-turbo-preview, gpt-3.5-turbo, etc.
# For Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229, etc.
LLM_MODEL=

# API Keys (use the one matching your LLM_PROVIDER)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# API Authentication
# If set, all API requests must include X-API-Key header with this value
# If not set, authentication is disabled (development mode)
API_KEY=

# CORS Configuration
# Comma-separated list of allowed origins, or '*' for all
# Example: http://localhost:5173,https://example.com
CORS_ORIGIN=*

# Rate Limiting
# Time window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100
