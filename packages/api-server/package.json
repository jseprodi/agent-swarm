{
  "name": "@agent-swarm/api-server",
  "version": "0.1.0",
  "description": "API server for Agent Swarm system",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:start": "node --watch dist/server.js",
    "dev:full": "npm run build && concurrently \"npm run dev\" \"npm run dev:start\"",
    "start": "node dist/server.js",
    "clean": "rm -rf dist || rmdir /s /q dist || true"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "concurrently": "^8.2.2"
  }
}

