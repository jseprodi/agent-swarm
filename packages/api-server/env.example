# Agent Swarm API Server Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=3000
NODE_ENV=development

# API Security
# Set this to require API key authentication (leave empty to disable)
API_KEY=

# CORS Configuration
# Comma-separated list of allowed origins (use * for all origins in development)
# Example: http://localhost:5173,https://yourdomain.com
CORS_ORIGIN=*

# Rate Limiting
# Time window for rate limiting in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# LLM Provider Configuration
# Options: cursor, openai, anthropic
LLM_PROVIDER=cursor

# OpenAI Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Model name (e.g., gpt-4-turbo-preview, gpt-3.5-turbo)
LLM_MODEL=

# Anthropic Configuration (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Model name (e.g., claude-3-5-sonnet-20241022)
# Note: LLM_MODEL is also used for Anthropic

# Logging
# Options: debug, info, warn, error
LOG_LEVEL=info

